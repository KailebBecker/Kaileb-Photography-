# Example nginx server block for the inquiry API (TLS terminates here; Node listens on 127.0.0.1 only).
# Replace api.example.com. Get the certificate with certbot (Let's Encrypt) once DNS points at the server.
# If the server already runs nginx, add this as a new server block; do not touch other sites.

server {
    listen 80;
    server_name api.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.example.com;

    # ssl_certificate / ssl_certificate_key lines are added by certbot.

    client_max_body_size 16k;          # the API itself also enforces a 16 KB body limit
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # Only the inquiry endpoint is exposed publicly. /health stays internal:
    # on the server run  curl http://127.0.0.1:8787/health
    location = /api/inquiries {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 20s;
    }

    location / {
        return 404;
    }
}
