# Copy to /etc/kaileb-inquiry/env on the server, chmod 600, owned by root:kaileb-inquiry.
# NEVER commit the real file, paste real values into chat, or put them in the website repo.

NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DB_PATH=/var/lib/kaileb-inquiry/inquiries.db

# Exact https origins allowed to call the API from a browser (comma-separated, no wildcard).
# Staging (GitHub Pages) now; add the real site origin when production exists.
ALLOWED_ORIGINS=https://kailebbecker.github.io

# true when running behind nginx/ALB so rate limiting sees the real client IP.
TRUST_PROXY=true

# Owner notification via Resend (https://resend.com). Until RESEND_API_KEY is set,
# inquiries are still stored and notifications stay pending (retried automatically).
NOTIFY_PROVIDER=resend
RESEND_API_KEY=
NOTIFY_TO=
NOTIFY_FROM=Kaileb Photography <onboarding@resend.dev>

# Optional bot check (Cloudflare Turnstile — free, works on any host). Leave empty to disable.
TURNSTILE_SECRET=

# Optional tuning (defaults shown)
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=600000
# PER_EMAIL_DAILY_CAP=5
