# Inquiry API environment — template with SAFE PLACEHOLDERS ONLY.
# Install on the server as /etc/kaileb-inquiry/env, owner root:root, mode 0600
# (systemd reads it as root before dropping to the service user).
# NEVER commit the real file, paste real values into chat, or put them in the website repo.
# Every variable the application reads is listed here; see server/README.md "Environment variables".

# --- Required -------------------------------------------------------------
NODE_ENV=production
# Loopback only: nginx is the only thing that talks to the app.
HOST=127.0.0.1
PORT=8787
# Outside the code checkout so git/npm/updates can never touch it.
DB_PATH=/var/lib/kaileb-inquiry/inquiries.db
# Exact browser origins allowed to submit (comma-separated). Scheme + host only:
# no path, no trailing page, no wildcard, https only.
# GitHub Pages staging is https://kailebbecker.github.io (NOT .../Kaileb-Photography-/).
# Add the production site origin(s) when known, e.g. https://<PRODUCTION_SITE_HOST>
ALLOWED_ORIGINS=https://kailebbecker.github.io
# Behind the local nginx: use the client IP nginx passes on (rate limiting).
# Requires HOST to be a loopback address (start-up refuses otherwise).
TRUST_PROXY=true

# --- Owner notification ----------------------------------------------------
# none   = store inquiries, email nobody (use until the Resend key exists;
#          check new inquiries with `kaileb-inquiries list`).
# resend = email each inquiry to NOTIFY_TO; then all three below are required
#          (start-up refuses otherwise).
NOTIFY_PROVIDER=none
RESEND_API_KEY=
NOTIFY_TO=
# Until a sending domain is verified in Resend, use the Resend test sender and set
# NOTIFY_TO to the email address of the Resend account itself.
NOTIFY_FROM=Kaileb Photography <onboarding@resend.dev>

# --- Optional bot check (Cloudflare Turnstile) -----------------------------
# Empty = disabled. Set ONLY after the matching public site key is live on the website,
# otherwise every submission is rejected.
TURNSTILE_SECRET=

# --- Google Calendar availability (optional; see server/README.md section 10) ---
# none   = availability uses weekly rules, manual blocks and confirmed sessions only.
# google = ALSO treat busy time in the owner's Google Calendar as unavailable. Once on, it is REQUIRED:
#          if it cannot be verified, public availability reports every date unavailable (never "available").
# Needs all three secrets below. The refresh token comes from `node src/calendar-auth.js` (README section 10).
CALENDAR_PROVIDER=none
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Required in practice when CALENDAR_PROVIDER=google: the calendar's Gmail address (NOT the nickname "primary",
# which Google rejects under the narrow free/busy scope). Comma-separated list for several calendars.
# GOOGLE_CALENDAR_ID=owner@example.com
# CALENDAR_MAX_STALE_MINUTES=60

# --- Optional tuning (defaults shown; leave commented unless needed) -------
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=600000
# PER_EMAIL_DAILY_CAP=5
