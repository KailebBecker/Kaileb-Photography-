[Unit]
Description=Kaileb Becker Photography inquiry API
After=network.target

[Service]
Type=simple
User=kaileb-inquiry
Group=kaileb-inquiry
WorkingDirectory=/opt/kaileb-inquiry/server
EnvironmentFile=/etc/kaileb-inquiry/env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

# Hardening: the service can only write to its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kaileb-inquiry
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
